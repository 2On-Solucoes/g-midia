# ============================================================
# G-Midia — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit real secrets to the repository.

APP_ENV=development
APP_NAME=G-Midia
APP_VERSION=1.0.0
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key-min-32-chars
APP_DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://gmidia:gmidia_dev@db:5432/gmidia

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=G-Midia

# JWT Auth
JWT_SECRET_KEY=change-this-jwt-secret-also-long-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Meta / Facebook (fill only in backend)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/meta/callback
META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_read_user_content,read_insights

# AI Provider (optional)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Storage (local for now)
MEDIA_STORAGE_PATH=/app/media
MAX_UPLOAD_SIZE_MB=25
